//
// AUTOMATICALLY GENERATED BY OLLIVANDER
//
// =============================================================================
// MAKO TEMPLATE FOR THE SOC SYSTEMVERILOG TESTBENCH
// =============================================================================
// This template generates a standard, out-of-the-box SystemVerilog testbench
// to simulate the generated SoC. It automatically configures the correct clock
// sources, initializes the resets, instantiates the Top-Level DUT, and provides
// an automated memory preloading mechanism to execute compiled C firmware.

// Include auto-generated SystemVerilog register macros from PeakRDL.
// These macros provide the absolute physical addresses of the CSRs, 
// making it extremely easy to write AXI/RegBus stimulus sequences.
`include "${rel_hw_from_tb}/${config.project.name}_regs.svh"

`timescale 1ns/1ps

module tb_${config.project.name}();

  // ===========================================================================
  // Clock and Reset definitions
  // ===========================================================================
  logic pwr_on_rst_ni;
  logic [${config.clock_tree.generators - 1}:0] domain_clk_i;
  logic [${config.clock_tree.generators - 1}:0] fll_lock_i;
  logic test_mode_i;
  logic [1:0] boot_mode_i;

  // ===========================================================================
  // Clock Generation
  // ===========================================================================
  // Dynamically generates the required number of clock sources (FLLs) 
  // based on the SoC's clock tree configuration.
  for (genvar i = 0; i < ${config.clock_tree.generators}; i++) begin: gen_clocks
    initial begin
      domain_clk_i[i] = 1'b0;
      forever #5 domain_clk_i[i] = ~domain_clk_i[i];
    end
  end

  // ===========================================================================
  // Reset Generation
  // ===========================================================================
  // Standard Power-On Reset (POR) sequence.
  // It holds the reset low, applies clocks, and then releases it.
  // It also fakes the FLL lock signals to allow the internal glitch-free clock 
  // multiplexers to seamlessly switch to the target frequencies.
  initial begin
    pwr_on_rst_ni = 1'b0;
    test_mode_i   = 1'b0;
    boot_mode_i   = 2'b0;
    fll_lock_i    = '0;
    #100;
    pwr_on_rst_ni = 1'b1;
    #1000;
    fll_lock_i = '1; // Assert FLL lock after reset is stable
  end

  // ===========================================================================
  // DUT Instantiation
  // ===========================================================================
  // Instantiates the absolute Top-Level of the generated SoC.
  ${config.project.name} dut (
    .domain_clk_i  (domain_clk_i),
    .fll_lock_i    (fll_lock_i),
    .pwr_on_rst_ni (pwr_on_rst_ni),
    .test_mode_i   (test_mode_i),
    .boot_mode_i   (boot_mode_i)
  );

  // ===========================================================================
  // Memory Preload ($readmemh)
  // ===========================================================================
  // Extracts the 'preload_memories' configuration from the YAML testbench 
  // section. It uses standard $readmemh to inject compiled firmware (hex) 
  // directly into the hierarchical SRAM instances before the boot sequence.
  // This avoids the need for complex JTAG/SPI boot preloaders in simulation.
<%
testbench_cfg = config.testbench or {}
preload_mems = testbench_cfg.get("preload_memories", [])
%>
% if preload_mems:
  initial begin
  % for mem in preload_mems:
    $display("[TB] Preloading memory ${mem['instance']} with ${mem['file']}...");
    $readmemh("${mem['file']}", dut.${mem['instance']});
  % endfor
  end
% endif

  // ===========================================================================
  // Test Sequence
  // ===========================================================================
  initial begin
    $display("[TB] Starting Simulation for ${config.project.name}...");
    // Wait for reset deassertion
    @(posedge pwr_on_rst_ni);
    $display("[TB] Reset deasserted. Running...");
    
    // =========================================================================
    // CUSTOM TEST STIMULI
    // =========================================================================
    // You can write your custom SystemVerilog tests here.
    // Use the PeakRDL macros (e.g., `${config.project.name.upper()}_SYS_CTRL_BASE_ADDR`) 
    // to drive AXI VIPs or directly peek into the design.

    #5000;
    
    $display("[TB] Simulation finished.");
    $finish;
  end

endmodule
