# ==============================================================================
# OLLIVANDER SoC GENERATOR - .gitignore
# ==============================================================================

# Generated Output Directories
generated/

# Hardware Dependency Manager (Bender)
bender_work/
.bender/
Bender.local
Bender.lock
Bender.yml
compile.tcl

# Ignore temporary commit message files
commit_message.txt

# Simulation Artifacts
obj_dir/
work/
verilator_work/
*.vcd
*.fst
*.wlf
*.vstf
transcript
modelsim.ini
# Core/DMA tracers write into the CWD: the emitted flows run from logs/ (ignored),
# but a manual run from a project root must not become a commit.
*.dasm
dma_trace_*.log

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# OS Generated Files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
.agents/
.claude/
CLAUDE.md
*.code-workspace
*.swp
*.bak
*~
*.tmp

# Others
_ext_references/

# ASIC target files: locally provisioned PDKs and technology data, never versioned here
target/

# Logs and temporary tool outputs
*.log
fast_check.log
.tmp_llvm_bin/
logs/

# A stray bender binary: the official installer drops it in the CURRENT directory,
# so a manual run from a project folder leaves a 13 MB executable there (found once,
# 2026-08-07). The generated Makefile installs into .venv/bin instead.
soc_cfg_examples/*/bender
